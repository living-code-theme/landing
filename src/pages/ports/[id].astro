---
// One page per port: its install text, a real screenshot when available, and every file it is made of.
// The title is the row you clicked, carried over by the transition.
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import DisclosureIcon from "../../components/DisclosureIcon.astro";
import Shot from "../../components/Shot.astro";
import FlavorGuide from "../../components/FlavorGuide.astro";
import Glyphs from "../../components/Glyphs.astro";
import Pager from "../../components/Pager.astro";
import { files, reportIssue, groupOf, ports, route, shipped, short, shotsOf, slug } from "../../lib/data.mjs";
import { portIcon } from "../../lib/icons.mjs";
import { renderPortGuide } from "../../lib/readme.mjs";
import { readPort } from "../../lib/ports.mjs";
import { siGithub } from "simple-icons";
import { back, h3 } from "../../lib/ui.mjs";

export function getStaticPaths() {
  return ports.map((p, i) => ({ params: { id: p.id }, props: { i } }));
}

const { i } = Astro.props;
const p = await readPort(ports[i]);
const prev = ports[(i - 1 + ports.length) % ports.length];
const next = ports[(i + 1) % ports.length];
const ships = shipped(p);
const hasShot = shotsOf(p.id).length > 0;
const icon = portIcon(p);

const all = files(p);
const host = p.homepage ? new URL(p.homepage).host.replace(/^www\./, "") : null;
const guides = Object.fromEntries(["night", "frost", "paper", "signal"].map((flavor) => [flavor,
  renderPortGuide(p.guide ?? p.readme, { repository: p.repository, revision: p.revision, images: p.guideImages ?? p.readmeImages, flavor: p.flavors.includes(flavor) ? flavor : "night" }),
]));
const guide = guides.night;
const options = [
  { label: "Configuration", section: "configuration" },
  { label: "Compatibility", section: "compatibility" },
].filter((option) => guide[option.section]);
---

<Base title={`Living Code for ${p.name}`} description={p.description}>
  <article>
    <header data-port-revision={p.revision} class="shell grid grid-cols-[minmax(0,1fr)] items-end gap-x-[clamp(40px,6vw,96px)] gap-y-8 pt-[clamp(40px,6vw,88px)] lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
      <div>
        <a class={back} href="/ports/" data-port-return><Arrow dir="left" /> All ports</a>
        <h1 class="mt-[clamp(24px,3vw,40px)] text-title font-semibold"><span class="inline-block" data-port-name={p.id}>{p.name}</span></h1>
        <dl class="mt-[clamp(32px,4vw,56px)] flex flex-wrap gap-x-[clamp(32px,5vw,72px)] gap-y-5 [&_dd_a]:text-accent [&_dd_code]:text-sm [&_dt]:mb-1.5 [&_dt]:text-sm [&_dt]:text-muted" data-rise style="--d:1">
          <div><dt>Get it</dt><dd set:html={route(p.id)} /></div>
          <div><dt>Group</dt><dd><a href={`/ports/#${slug(groupOf[p.id])}`}>{groupOf[p.id]}</a></dd></div>
          {host && <div><dt>App</dt><dd><a href={p.homepage}>{host}</a></dd></div>}
          <div><dt>Source</dt><dd>
            <a href={p.repository} aria-label={`${p.name} repository on GitHub`} title={`${p.name} on GitHub`} class="-my-2 -ml-2.5 inline-flex size-11 items-center justify-center no-underline transition-colors hover:text-accent-2" data-port-repository>
              <svg class="size-6" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={siGithub.path} /></svg>
            </a>
          </dd></div>
          <div><dt>Problem?</dt><dd><a href={reportIssue(p.repository)} data-port-issues>Report an issue</a></dd></div>
          <div>
            <dt>Flavors</dt>
            <dd class="flex flex-wrap gap-1">
              {ships.map((f) => (
                <button type="button" data-bar data-set-flavor={f.id} aria-pressed="false" class="inline-flex items-center gap-2 bg-bg-alt px-3 py-1.5 text-sm text-muted transition-colors hover:bg-surface hover:text-fg aria-pressed:bg-surface aria-pressed:text-fg"><i data-theme={f.slug} class="size-2.5 bg-keyword" />{short(f)}</button>
              ))}
            </dd>
          </div>
        </dl>
      </div>
      <Glyphs shape={`icon:${p.id}`} data-glyph-path={icon.path} data-glyph-text={icon.text} class="aspect-square w-full max-w-[340px] justify-self-end max-lg:max-w-[220px] max-lg:justify-self-center" label={`The ${icon.title ?? p.name} ${icon.path ? "logo" : "name"}, drawn in code glyphs`}>
        {icon.path
          ? <svg viewBox="0 0 24 24" class="w-[62%] text-accent" aria-hidden="true"><path fill="currentColor" d={icon.path} /></svg>
          : <span class="font-mono text-[clamp(40px,7vw,88px)] font-bold text-accent">{icon.text}</span>}
      </Glyphs>
    </header>

    <div class="shell grid grid-cols-[minmax(0,1fr)] items-start gap-x-[clamp(40px,6vw,96px)] gap-y-12 pt-[clamp(72px,8vw,128px)] lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
      <section class="prose port-readme" aria-labelledby="install-h" data-reveal>
        <div class="mb-6 flex min-h-11 items-center justify-between gap-4">
          <h2 class={h3} id="install-h">Install</h2>
        </div>
        {guide.installation ? <FlavorGuide guides={guides} section="installation" /> : <p>See the repository for installation instructions.</p>}
      </section>
      {(options.length > 0 || all.length > 0) && (
        <section aria-labelledby="options-h" data-reveal style="--d:1">
          <h2 class:list={[h3, "mb-6 flex min-h-11 items-center"]} id="options-h">Details</h2>
          {options.map((option) => <details class="port-option">
            <summary>{option.label}<DisclosureIcon /></summary>
            <div class="prose port-readme"><FlavorGuide guides={guides} section={option.section} /></div>
          </details>)}
          {all.length > 0 && <details class="port-option">
            <summary>Included files <span class="ml-auto text-sm text-muted">{all.length}</span><DisclosureIcon /></summary>
            <div>
              <ul class="grid gap-0.5">
                {all.map((path) => <li><a class="block bg-bg-alt px-3.5 py-2.5 text-fg-alt no-underline [overflow-wrap:anywhere] transition-[background-color,color,padding] duration-300 hover:bg-surface hover:pl-5 hover:text-fg" href={p.fileUrls[path]}><code class="text-sm">{path}</code></a></li>)}
              </ul>
            </div>
          </details>}
        </section>
      )}
    </div>

    {hasShot && (
      <div class="shell pt-[clamp(40px,5vw,72px)]">
        <Shot app={p.id} sizes="(min-width: 1440px) 1360px, 100vw" />
      </div>
    )}

    {ports.length > 1 && <Pager prev={{ href: `/ports/${prev.id}/`, label: prev.name }} next={{ href: `/ports/${next.id}/`, label: next.name }} label="More ports" />}
  </article>
</Base>
