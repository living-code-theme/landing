---
// Search the registry locally, then go straight to the chosen port's page.
import Arrow from "./Arrow.astro";
import PortIcon from "./PortIcon.astro";
import { PORT_REQUEST, REPO, groups, keys, portCount, slug } from "../lib/data.mjs";
---

<dialog class="port-finder" id="port-finder" aria-labelledby="port-finder-title" aria-describedby="port-finder-help" data-port-list>
  <div class="flex items-start justify-between gap-4 px-5 pt-5 sm:px-8 sm:pt-7">
    <div>
      <h2 class="text-2xl font-semibold tracking-tight" id="port-finder-title">Ports &amp; installation</h2>
      <p class="mt-1 text-sm text-muted" id="port-finder-help">Find your app. Open its port page for installation steps.</p>
    </div>
    <form method="dialog">
      <button class="-mr-2 -mt-2 grid size-11 place-items-center text-muted transition-colors hover:bg-surface hover:text-fg" aria-label="Close port finder">
        <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" /></svg>
      </button>
    </form>
  </div>
  <div class="px-5 py-5 sm:px-8">
    <label class="sr-only" for="port-finder-input">Find your app</label>
    <div class="flex items-center gap-3 bg-deep px-4 focus-within:outline-2 focus-within:outline-accent">
      <svg class="size-5 shrink-0 text-muted" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m12.5 12.5 4 4" /></svg>
      <input class="min-w-0 flex-1 bg-transparent py-4 text-lg outline-none placeholder:text-muted" id="port-finder-input" type="search" placeholder="Search published ports…" autocomplete="off" autocapitalize="off" spellcheck="false" data-port-filter autofocus role="combobox" aria-autocomplete="list" aria-expanded="true" aria-controls="port-finder-results" aria-describedby="port-finder-keys" />
      <span class="whitespace-nowrap text-sm text-muted tabular-nums" data-port-count role="status">{portCount}</span>
    </div>
    <p class="mt-3 text-sm text-muted" id="port-finder-keys">Use <kbd>↑</kbd> <kbd>↓</kbd> to choose, <kbd>Enter</kbd> to open. Keep typing to search.</p>
  </div>
  <div class="port-finder__results min-h-0 overflow-y-auto overscroll-contain px-5 pb-6 sm:px-8" tabindex="-1">
    <div id="port-finder-results" role="listbox" aria-label="Available ports">
      {groups.map((g) => (
        <section class="not-first:mt-6" data-port-group role="group" aria-labelledby={`finder-${slug(g.title)}`}>
          <h3 class="mb-2 text-sm font-medium text-muted" id={`finder-${slug(g.title)}`} aria-hidden="true">{g.title}</h3>
          <ul role="presentation">
            {g.ports.map((p) => (
              <li class="border-b border-line" data-port-keys={keys(p)} role="presentation">
                <a class="port-link flex min-h-14 items-center gap-4 px-3 py-3 font-medium no-underline" href={`/ports/${p.id}/`} id={`finder-port-${p.id}`} role="option" aria-selected="false" tabindex="-1">
                  <PortIcon port={p} />
                  <span class="port-name inline-block min-w-0 [overflow-wrap:anywhere]">{p.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <p class="py-6 text-fg-alt [&_a]:text-accent" data-port-none hidden>
      No port for “<span data-query></span>” yet. Try another app name, <a href={PORT_REQUEST}>request a port</a>, or use the <a href={`${REPO}/blob/main/palette.json`}>palette</a>.
    </p>
  </div>
  <div class="flex items-center justify-between gap-4 border-t border-line px-5 py-3 text-sm sm:px-8">
    <a class="inline-flex min-h-11 items-center gap-2 text-accent" href="/ports/">Browse {portCount} <Arrow /></a>
    <span class="text-muted max-sm:hidden"><kbd>Esc</kbd> to close</span>
  </div>
</dialog>
