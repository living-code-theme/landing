---
import Glyphs from "./Glyphs.astro";
import { ports } from "../lib/data.mjs";
import { portIcon } from "../lib/icons.mjs";
import { GLYPHS } from "../lib/theme.mjs";
import { SPIRAL, SPIRAL_IDS, spiralLayout } from "../lib/port-spiral.mjs";

const icons = spiralLayout(SPIRAL_IDS.flatMap((id) => {
  const port = ports.find((p) => p.id === id);
  return port ? [{ id, name: port.name, ...portIcon(port) }] : [];
}));
const mark = ["[", "l", "c", "]"].map((ch, i) => ({ path: GLYPHS[ch], x: i * 600 }));
---

<Glyphs shape="port-spiral" class="relative mx-auto aspect-[9/7] w-full max-w-[560px]" label={icons.length ? `Living Code with published app icons: ${icons.map((icon) => icon.name).join(", ")}` : "The Living Code mark"} data-spiral-icons={JSON.stringify(icons)} data-spiral-mark={JSON.stringify(mark)}>
  <svg viewBox={`0 0 ${SPIRAL.width} ${SPIRAL.height}`} class="size-full" fill="currentColor" aria-hidden="true">
    <g transform="translate(390 368) scale(0.05 -0.05)" class="text-accent">
      {mark.map(({ path, x }) => <path d={path} transform={`translate(${x} 0)`} />)}
    </g>
    {icons.map(({ path, x, y, size, role }) => (
      <path d={path} transform={`translate(${x - size / 2} ${y - size / 2}) scale(${size / 24})`} style={`color:var(--lc-${role})`} />
    ))}
  </svg>
</Glyphs>
