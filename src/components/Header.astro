---
// The bar on every page. It persists across navigations, so the flavor menu and its state survive a page change.
import Mark from "./Mark.astro";
import Arrow from "./Arrow.astro";
import { CLAUSES, ORG, flavors, short } from "../lib/data.mjs";

const links = [
  ["/#calm", "Palette"],
  ["/#flavors", "Flavors"],
];
---

<header
  class="shell sticky top-0 z-50 flex h-(--head) items-center gap-3 bg-bg/80 backdrop-blur-md sm:gap-8"
  transition:persist="site-header"
  transition:name="site-header"
>
  <a class="group flex items-center gap-3.5 font-semibold tracking-tight no-underline" href="/#hero" aria-label="Living Code, home">
    <Mark class="w-auto h-5 text-accent transition-transform duration-500 ease-spring group-hover:scale-110" />
    <span class="whitespace-nowrap max-sm:hidden">Living Code</span>
  </a>

  <nav
    class="site-nav ml-auto max-lg:fixed max-lg:inset-x-0 max-lg:top-(--head) max-lg:hidden max-lg:h-[calc(100dvh-var(--head))] max-lg:content-start max-lg:gap-8 max-lg:bg-bg max-lg:px-(--margin) max-lg:py-8 in-[.nav-open]:max-lg:grid"
    id="site-nav"
    aria-label="Main"
  >
    <ul class="flex gap-[clamp(18px,2.2vw,32px)] max-lg:flex-col max-lg:gap-1">
      {links.map(([href, label], i) => (
        <li class="in-[.nav-open]:max-lg:animate-[rise_0.5s_var(--ease-out)_both]" style={`animation-delay:${i * 40}ms`}>
          <a class="draw text-sm text-muted no-underline transition-colors hover:text-fg max-lg:block max-lg:py-2 max-lg:text-[clamp(1.75rem,6vw,2.5rem)] max-lg:font-semibold max-lg:tracking-tight max-lg:text-fg max-lg:after:hidden" href={href}>{label}</a>
        </li>
      ))}
    </ul>
    <a class="text-accent lg:hidden" href={ORG}>Source on GitHub</a>
  </nav>

  <a class="ml-auto inline-flex min-h-11 items-center gap-3 bg-bg-alt px-3 text-sm font-medium text-fg no-underline transition-colors hover:bg-surface lg:ml-0" href="/ports/#port-filter" data-port-finder-open aria-haspopup="dialog" aria-controls="port-finder" data-astro-reload>
    Ports &amp; install
    <kbd class="text-xs text-muted max-sm:hidden" data-port-shortcut aria-hidden="true">Ctrl K</kbd>
  </a>

  <div class="flavor-menu relative">
    <button type="button" class="flex min-h-10 items-center gap-2 px-1.5 text-sm font-medium text-muted transition-colors hover:text-fg aria-expanded:text-fg" aria-expanded="false" aria-controls="flavor-list" data-flavor-toggle>
      <span class="sr-only">Flavor: </span>
      <span class="grid grid-cols-2 gap-px" aria-hidden="true"><i class="size-1.5 bg-keyword" /><i class="size-1.5 bg-string" /><i class="size-1.5 bg-number" /><i class="size-1.5 bg-function" /></span>
      <span data-flavor-name>Night</span>
      <svg class="size-3 transition-transform duration-300 in-aria-expanded:rotate-180" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5l3-3" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
    </button>
    <!-- taste-skill-ignore: the flavor menu is a real overlay and floats -->
    <ul class="absolute right-0 top-[calc(100%+10px)] w-80 origin-top-right animate-[menu-in_0.32s_var(--ease-out)] bg-bg-alt p-1.5 shadow-[0_24px_48px_-12px_oklch(0_0_0/0.45)]" id="flavor-list" hidden>
      {flavors.map((f) => (
        <li>
          <button type="button" data-bar class="flex w-full items-center gap-3.5 p-3 text-left transition-colors hover:bg-surface aria-pressed:bg-surface" data-set-flavor={f.id} aria-pressed={f.id === "night" ? "true" : "false"}>
            <span class="grid grid-cols-2 gap-0.5 bg-bg p-[3px]" data-theme={f.slug} aria-hidden="true">
              <i class="size-3 bg-bg-alt" /><i class="size-3 bg-keyword" /><i class="size-3 bg-string" /><i class="size-3 bg-number" />
            </span>
            <span class="grid"><b class="font-semibold">{short(f)}</b><span class="text-sm text-muted">{CLAUSES[f.id]}</span></span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <a class="inline-flex items-center gap-2 text-sm text-muted no-underline transition-colors hover:text-fg max-lg:hidden" href={ORG}>GitHub <Arrow dir="out" /></a>

  <button type="button" class="-mr-2.5 grid size-11 place-content-center gap-1.5 lg:hidden" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
    <span class="sr-only">Menu</span>
    <i class="block h-0.5 w-[22px] bg-fg transition-transform duration-300 in-aria-expanded:translate-y-1 in-aria-expanded:rotate-45" />
    <i class="block h-0.5 w-[22px] bg-fg transition-transform duration-300 in-aria-expanded:-translate-y-1 in-aria-expanded:-rotate-45" />
  </button>
</header>
