---
// A contact sheet of real apps, with one full-width capture in the site's selected flavor.
// Without script the controls stay hidden and every capture and install link remains visible.
import Arrow from "./Arrow.astro";
import PortIcon from "./PortIcon.astro";
import Shot from "./Shot.astro";
import { APPS, flavors, ports, route, short, shotsOf } from "../lib/data.mjs";
import { fill, h2, lead, section } from "../lib/ui.mjs";

const captureLabel = (app: string, flavor: typeof flavors[number]) => {
  const shots = shotsOf(app);
  const own = shots.find((shot) => shot.f.id === flavor.id);
  const shot = own ?? shots.find((shot) => shot.f.id === "night") ?? shots[0];
  return `${short(shot.f)}${own ? "" : ` · No ${short(flavor)} capture yet`}`;
};
const portFor = (id: string) => ports.find((p) => p.id === id)!;
const contexts: Record<string, string> = {
  vscode: "Code editor", jetbrains: "Development environment", sublime: "Text editor",
  obsidian: "Notes & knowledge", chrome: "Web browser",
};
---

<section class:list={[section, "workspace-gallery"]} id="in-use" aria-labelledby="in-use-title">
  <div class="workspace-gallery__intro">
    <h2 class={h2} id="in-use-title" data-reveal>See it where<br /><span class="text-accent">you work.</span></h2>
    <p class={lead} data-reveal style="--d:1">Real screenshots, not mockups: each app running with Living Code installed. They follow the flavor you pick.</p>
  </div>

  <div class="app-showcase" data-app-showcase>
    <div class="app-showcase__toolbar">
      <p class="app-showcase__label">Your tools. <span>Your colors.</span></p>
      <div class="app-showcase__flavors" role="group" aria-label="Preview flavor">
        {flavors.map((f) => (
          <button type="button" data-set-flavor={f.id} aria-pressed={f.id === "night" ? "true" : "false"}>
            <span class="app-showcase__swatch" data-theme={f.slug} aria-hidden="true">
              <span class="bg-bg-alt" /><span class="bg-keyword" /><span class="bg-string" /><span class="bg-number" />
            </span>
            {short(f)}
          </button>
        ))}
      </div>
    </div>

    <div class="app-showcase__tabs" role="tablist" aria-label="App" data-app-tabs hidden>
      {APPS.map((a, i) => (
        <button type="button" role="tab" id={`app-tab-${a.port}`} aria-controls={`app-panel-${a.port}`}
          aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-app-tab={a.port}>
          <span class="app-showcase__thumbnail"><Shot app={a.port} thumbnail sizes="(min-width: 768px) 240px, 144px" /></span>
          <span class="app-showcase__tab-label"><PortIcon port={portFor(a.port)} /><span>{a.name}</span><span class="app-showcase__tab-mark" aria-hidden="true" /></span>
        </button>
      ))}
    </div>

    <div class="app-showcase__panels">
      {APPS.map((a) => (
        <section class="app-showcase__panel" id={`app-panel-${a.port}`} aria-label={a.name} data-app-panel={a.port}>
          <div class="app-showcase__stage">
            <div class="app-showcase__identity">
              <div class="app-showcase__app-name"><PortIcon port={portFor(a.port)} /><h3>{a.name}</h3></div>
              <p>{contexts[a.port] ?? portFor(a.port).group}<span aria-hidden="true"> / </span><span class="text-fg-alt" data-flavor-name>Night</span></p>
            </div>
            <div class="app-showcase__capture">
              <Shot app={a.port} sizes="(min-width: 1536px) 1376px, (min-width: 768px) 88vw, 100vw" caption={false} />
              <span class="app-showcase__image-status" data-image-status role="status" aria-live="polite" />
            </div>
            <div class="app-showcase__capture-note"><span class="app-showcase__status" aria-hidden="true" /><span>{portFor(a.port).repository ? "From the port repository." : "Real app. Fresh profile."}</span><span>{flavors.map((f) => <span data-only={f.id}>{captureLabel(a.port, f)}</span>)}</span></div>
          </div>
          <div class="app-showcase__install">
            <p><span class="app-showcase__install-label">Make yourself at home.</span><span class="app-showcase__route" set:html={route(a.port)} /></p>
            <a class:list={[fill, "app-showcase__install-link"]} href={`/ports/${a.port}/`}>Install for {a.name} <Arrow /></a>
          </div>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .workspace-gallery__intro {
    display: grid; grid-template-columns: 1.15fr 1fr; align-items: end;
    gap: 32px clamp(40px, 6vw, 96px); margin-bottom: clamp(40px, 4.5vw, 64px);
  }
  .app-showcase { display: grid; grid-template-columns: minmax(0, 1fr); }
  .app-showcase [hidden] { display: none; }
  .app-showcase__toolbar {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding-block: 20px; border-top: 1px solid var(--lc-border);
  }
  .app-showcase__label { font-size: 0.9375rem; font-weight: 500; }
  .app-showcase__label > span { color: var(--lc-fg-muted); }
  .app-showcase__flavors { display: flex; gap: 4px; }
  .app-showcase__flavors button {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 44px; padding: 8px 12px; color: var(--lc-fg-muted); font-size: 0.8125rem;
    transition: color 180ms, background-color 180ms;
  }
  .app-showcase__flavors button:hover { color: var(--lc-fg); background: var(--lc-bg-alt); }
  .app-showcase__flavors button[aria-pressed="true"] { color: var(--lc-fg); background: var(--lc-surface0); }
  .app-showcase__swatch {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; flex: none;
    width: 20px; height: 20px; padding: 2px;
    background: var(--lc-bg);
  }
  .app-showcase__panels { display: grid; gap: 56px; min-width: 0; }
  .app-showcase__stage { padding: clamp(16px, 2.25vw, 32px); background: var(--lc-bg-alt); }
  .app-showcase__identity { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 24px; }
  .app-showcase__app-name { display: flex; align-items: center; gap: 12px; }
  .app-showcase__app-name h3 { font-size: clamp(1.125rem, 1.6vw, 1.5rem); font-weight: 500; letter-spacing: -0.025em; }
  .app-showcase__app-name :global([data-port-icon]) { color: var(--lc-accent); }
  .app-showcase__identity > p { color: var(--lc-fg-muted); font-size: 0.8125rem; }
  .app-showcase__identity > p > span[aria-hidden] { padding-inline: 12px; color: var(--lc-overlay); }
  .app-showcase__capture { position: relative; box-shadow: 0 16px 40px -12px color-mix(in oklch, var(--lc-bg-deep) 70%, transparent); }
  .app-showcase__capture :global([data-shot]) { overflow: hidden; background-image: var(--capture-preview, none); background-size: cover; background-position: center; }
  .app-showcase__capture[data-image-state="loading"] :global(img),
  .app-showcase__capture[data-image-state="error"] :global(img) { opacity: 0; }
  .app-showcase__image-status { position: absolute; inset-inline: 16px; bottom: 16px; width: fit-content; max-width: calc(100% - 32px); padding: 8px 12px; background: var(--lc-bg-alt); color: var(--lc-fg); font-size: 0.8125rem; }
  .app-showcase__image-status:empty { display: none; }
  .app-showcase__capture :global(img) { transition: none; transform: none; scale: 1; }
  .app-showcase__capture-note { display: flex; align-items: center; gap: 8px; margin-top: 20px; color: var(--lc-fg-muted); font-size: 0.75rem; }
  .app-showcase__capture-note > :last-child { margin-left: auto; }
  .app-showcase__status { width: 6px; height: 6px; flex: none; background: var(--lc-accent); }
  .app-showcase__install { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding-block: 28px; }
  .app-showcase__install > p { display: grid; gap: 5px; min-width: 0; }
  .app-showcase__install-label { color: var(--lc-fg); font-size: 1rem; font-weight: 500; }
  .app-showcase__route { color: var(--lc-fg-muted); font-size: 0.8125rem; overflow-wrap: anywhere; }
  .app-showcase__route :global(code) { color: var(--lc-fg-alt); }
  .app-showcase__install-link { flex: none; }
  .app-showcase__tabs {
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(12px, 1.75vw, 24px);
    padding-block: 0 24px;
  }
  .app-showcase__tabs button { min-width: 0; text-align: left; color: var(--lc-fg-muted); }
  .app-showcase__thumbnail {
    display: block; padding: 5px; background: var(--lc-bg-alt); outline: 1px solid transparent; outline-offset: -1px;
    transition: outline-color 220ms, background-color 220ms;
  }
  .app-showcase__thumbnail :global(img) { opacity: 0.55; transition: opacity 220ms; }
  .app-showcase__tabs button:hover .app-showcase__thumbnail :global(img),
  .app-showcase__tabs button[aria-selected="true"] .app-showcase__thumbnail :global(img) { opacity: 1; }
  .app-showcase__tabs button[aria-selected="true"] .app-showcase__thumbnail { outline-color: var(--lc-accent); background: var(--lc-surface0); }
  .app-showcase__tab-label { display: flex; align-items: center; gap: 8px; min-height: 44px; margin-top: 6px; font-size: 0.8125rem; transition: color 220ms; }
  .app-showcase__tab-label :global([data-port-icon]), .app-showcase__tab-label :global(svg) { width: 16px; height: 16px; color: inherit; }
  .app-showcase__tabs button:hover, .app-showcase__tabs button[aria-selected="true"] { color: var(--lc-fg); }
  .app-showcase__tab-mark { width: 6px; height: 6px; margin-left: auto; flex: none; background: var(--lc-accent); opacity: 0; transition: opacity 220ms; }
  .app-showcase__tabs button[aria-selected="true"] .app-showcase__tab-mark { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .app-showcase__panel[role="tabpanel"] .app-showcase__capture { animation: capture-in 420ms var(--ease-out); }
    @keyframes capture-in { from { opacity: 0.65; clip-path: inset(0 0 5% 0); transform: translateY(8px); } }
  }
  @media (max-width: 767px) {
    .workspace-gallery__intro { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .app-showcase__toolbar { flex-direction: column; align-items: start; gap: 12px; padding-block: 20px; }
    .app-showcase__flavors { width: 100%; justify-content: space-between; }
    .app-showcase__flavors button { padding-inline: 8px; }
    .app-showcase__stage { margin-inline: calc(-1 * var(--margin)); padding: 20px var(--margin) 16px; }
    .app-showcase__identity { align-items: start; flex-direction: column; gap: 4px; margin-bottom: 18px; }
    .app-showcase__identity > p { padding-left: 36px; }
    .app-showcase__identity > p > span[aria-hidden] { padding-inline: 6px; }
    .app-showcase__capture { margin-inline: calc(-1 * var(--margin)); box-shadow: none; }
    .app-showcase__capture-note { margin-top: 16px; font-size: 0.6875rem; }
    .app-showcase__install { align-items: stretch; flex-direction: column; gap: 20px; padding-block: 24px; }
    .app-showcase__tabs {
      display: flex; gap: 12px; overflow-x: auto; margin-inline: calc(-1 * var(--margin));
      padding: 0 var(--margin) 20px; scroll-padding-inline: var(--margin); scroll-snap-type: x proximity;
      scrollbar-width: thin; scrollbar-color: var(--lc-overlay) var(--lc-bg-alt);
    }
    .app-showcase__tabs button { flex: 0 0 144px; scroll-snap-align: start; }
  }
  @media (max-width: 359px) {
    .app-showcase__flavors button { flex-direction: column; gap: 6px; }
  }
  @media (scripting: none) { .app-showcase__flavors { display: none; } }
</style>
