---
// A contact sheet of real apps, with one full-width capture in the site's selected flavor.
// Without script a bounded initial selection and its install links remain visible; the catalog retains every port.
import AppPreview from "./AppPreview.astro";
import { APPS, flavors, short } from "../lib/data.mjs";
import { showcaseData } from "../lib/showcase-data";
import { h2, lead, section } from "../lib/ui.mjs";
const initial = APPS.slice(0, 5);
const catalog = APPS.length > 5 ? (await showcaseData).indexUrl : undefined;
---

<section class:list={[section, "workspace-gallery"]} id="in-use" aria-labelledby="in-use-title">
  <div class="workspace-gallery__intro">
    <h2 class={h2} id="in-use-title" data-reveal>See it where<br /><span class="text-accent">you work.</span></h2>
    <p class={lead} data-reveal style="--d:1">Real screenshots, not mockups: each app running with Living Code installed. They follow the flavor you pick.</p>
  </div>

  <div class="app-showcase" data-app-showcase data-app-catalog={catalog}>
    <div class="app-showcase__toolbar">
      <div class="app-showcase__flavors" role="group" aria-label="Preview flavor">
        {flavors.map((f) => (
          <button type="button" data-set-flavor={f.id} aria-pressed={f.id === "night" ? "true" : "false"}>
            <span class="app-showcase__swatch" data-theme={f.slug} aria-hidden="true">
              <span class="bg-bg-alt" /><span class="bg-keyword" /><span class="bg-string" /><span class="bg-number" />
            </span>
            {short(f)}
          </button>
        ))}
      </div>
    </div>

    <div class="app-showcase__tabs" role="tablist" aria-label="App" data-app-tabs hidden>
      {initial.map((app, i) => <AppPreview app={app} part="tab" selected={i === 0} />)}
    </div>

    <div class="app-showcase__panels">
      {initial.map((app) => <AppPreview app={app} part="panel" />)}
    </div>
  </div>
</section>

<style is:global>
  .workspace-gallery__intro {
    display: grid; grid-template-columns: 1.15fr 1fr; align-items: end;
    gap: 32px clamp(40px, 6vw, 96px); margin-bottom: clamp(40px, 4.5vw, 64px);
  }
  .app-showcase { display: grid; grid-template-columns: minmax(0, 1fr); }
  .app-showcase [hidden] { display: none; }
  .app-showcase__toolbar {
    display: flex; padding-block: 0 20px;
  }
  .app-showcase__flavors { display: flex; gap: 4px; }
  .app-showcase__flavors button {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 44px; padding: 8px 12px; color: var(--lc-fg-muted); font-size: 0.8125rem;
    transition: color 180ms, background-color 180ms;
  }
  .app-showcase__flavors button:hover { color: var(--lc-fg); background: var(--lc-bg-alt); }
  .app-showcase__flavors button[aria-pressed="true"] { color: var(--lc-fg); background: var(--lc-surface0); }
  .app-showcase__swatch {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; flex: none;
    width: 20px; height: 20px; padding: 2px;
    background: var(--lc-bg);
  }
  .app-showcase__panels { display: grid; gap: 56px; min-width: 0; }
  .app-showcase__app-name { display: flex; align-items: center; gap: 12px; font-size: clamp(1.125rem, 1.6vw, 1.5rem); font-weight: 500; letter-spacing: -0.025em; }
  .app-showcase__app-name [data-port-icon] { color: var(--lc-accent); }
  .app-showcase__note { margin-top: 4px; color: var(--lc-fg-muted); font-size: 0.8125rem; }
  .app-showcase__capture { position: relative; padding: clamp(8px, 1.25vw, 16px); background: var(--lc-bg-alt); }
  .app-showcase__capture [data-shot] { overflow: hidden; background-image: var(--capture-preview, none); background-size: cover; background-position: center; }
  .app-showcase__capture[data-image-state="loading"] img,
  .app-showcase__capture[data-image-state="error"] img { opacity: 0; }
  .app-showcase__image-status { position: absolute; inset-inline: 16px; bottom: 16px; width: fit-content; max-width: calc(100% - 32px); padding: 8px 12px; background: var(--lc-bg-alt); color: var(--lc-fg); font-size: 0.8125rem; }
  .app-showcase__image-status:empty { display: none; }
  .app-showcase__capture img { transition: none; transform: none; scale: 1; }
  .app-showcase__install { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding-block: 24px; }
  .app-showcase__install-link { flex: none; }
  .app-showcase__tabs {
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(12px, 1.75vw, 24px);
    padding-block: 0 24px;
  }
  .app-showcase__tabs button { min-width: 0; text-align: left; color: var(--lc-fg-muted); }
  .app-showcase__thumbnail {
    display: block; padding: 5px; background: var(--lc-bg-alt); outline: 1px solid transparent; outline-offset: -1px;
    transition: outline-color 220ms, background-color 220ms;
  }
  .app-showcase__thumbnail img { opacity: 0.55; transition: opacity 220ms; }
  .app-showcase__tabs button:hover .app-showcase__thumbnail img,
  .app-showcase__tabs button[aria-selected="true"] .app-showcase__thumbnail img { opacity: 1; }
  .app-showcase__tabs button[aria-selected="true"] .app-showcase__thumbnail { outline-color: var(--lc-accent); background: var(--lc-surface0); }
  .app-showcase__tab-label { display: flex; align-items: center; gap: 8px; min-height: 44px; margin-top: 6px; font-size: 0.8125rem; transition: color 220ms; }
  .app-showcase__tab-label [data-port-icon], .app-showcase__tab-label svg { width: 16px; height: 16px; color: inherit; }
  .app-showcase__tabs button:hover, .app-showcase__tabs button[aria-selected="true"] { color: var(--lc-fg); }
  @media (prefers-reduced-motion: no-preference) {
    .app-showcase__panel[role="tabpanel"] .app-showcase__capture { animation: capture-in 420ms var(--ease-out); }
    @keyframes capture-in { from { opacity: 0.65; clip-path: inset(0 0 5% 0); transform: translateY(8px); } }
  }
  @media (max-width: 1023px) {
    .app-showcase__toolbar { display: none; }
  }
  @media (max-width: 767px) {
    .workspace-gallery__intro { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .app-showcase__capture { margin-inline: calc(-1 * var(--margin)); padding: 0; }
    .app-showcase__install { align-items: stretch; flex-direction: column; gap: 16px; padding-block: 20px; }
    .app-showcase__tabs {
      display: flex; gap: 12px; overflow-x: auto; margin-inline: calc(-1 * var(--margin));
      padding: 0 var(--margin) 20px; scroll-padding-inline: var(--margin); scroll-snap-type: x proximity;
      scrollbar-width: thin; scrollbar-color: var(--lc-overlay) var(--lc-bg-alt);
    }
    .app-showcase__tabs button { flex: 0 0 144px; scroll-snap-align: start; }
  }
  @media (scripting: none) { .app-showcase__flavors { display: none; } }
</style>
