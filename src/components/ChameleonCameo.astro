---
// The footer companion: a still portrait of the hero's model (shown without script or with reduced motion),
// brought to life by the same model drawn into a small canvas.
import { chameleonPortrait } from "../scripts/living/chameleon";
interface Props { pose: "perched" | "sleeping"; interactive?: boolean; class?: string }
const { pose, interactive = false, class: className } = Astro.props;
const portrait = chameleonPortrait(pose);
const Tag = interactive ? "button" : "span";
---

<Tag class:list={["chameleon-companion", className]} type={interactive ? "button" : undefined}
  data-cameo-control={interactive || undefined} disabled={interactive || undefined}
  aria-label={interactive ? "Startle the chameleon" : undefined}>
  <svg class="chameleon-cameo" data-chameleon-cameo={pose}
    viewBox={`0 0 ${portrait.width} ${portrait.height}`} aria-hidden="true" focusable="false">
    {portrait.parts.map((part) => (
      <g data-cameo-part={part.name}>
        {part.runs.map((run) => (
          <text x={run.x.join(" ")} y={run.y.join(" ")} fill={`var(--lc-${run.role.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`)})`}
            opacity={run.opacity} font-size={run.size}>{run.text}</text>
        ))}
      </g>
    ))}
  </svg>
  {interactive && <canvas class="chameleon-companion__live" aria-hidden="true" hidden />}
</Tag>
{interactive && <span class="sr-only" data-cameo-status role="status" aria-live="polite" />}

<style>
  .chameleon-companion { position: relative; display: block; min-height: 44px; padding: 0; border: 0; background: transparent; user-select: none; }
  button.chameleon-companion:not(:disabled) { cursor: pointer; touch-action: manipulation; }
  button.chameleon-companion[aria-disabled="true"] { cursor: default; }
  .chameleon-companion:focus-visible { outline: 2px solid var(--lc-accent); outline-offset: 6px; }
  .chameleon-cameo { display: block; width: 100%; overflow: visible; pointer-events: none; }
  /* taste-skill-ignore: actual code glyphs sampled from the hero's 3D mascot. */
  .chameleon-cameo text { font-family: var(--font-mono); font-weight: 600; font-variant-ligatures: none; text-anchor: middle; dominant-baseline: central; transition: fill 400ms var(--ease-out); }
  /* The live drawing overhangs its slot, so the hop and the tail never clip; it never takes a click itself. */
  .chameleon-companion__live { position: absolute; inset: -32px; width: calc(100% + 64px); height: calc(100% + 64px); pointer-events: none; z-index: 40; }
  [data-cameo-live] .chameleon-cameo { visibility: hidden; }
  @media (prefers-reduced-motion: reduce) {
    .chameleon-cameo text { transition: none; }
  }
</style>

<script>
  import { chameleonCameos } from "../scripts/chameleon-cameo";
  let stop = () => {};
  document.addEventListener("astro:page-load", () => { stop(); stop = chameleonCameos(); });
  document.addEventListener("astro:before-swap", () => stop());
</script>
