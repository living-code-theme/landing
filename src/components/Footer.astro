---
// The close: the glyphs gather into the mark one last time, then where to go next, and the license.
import Mark from "./Mark.astro";
import ChameleonCameo from "./ChameleonCameo.astro";
import Glyphs from "./Glyphs.astro";
import { COLOR_FEEDBACK, ORG, PORT_REQUEST, REPO, flavorById, flavors, groups, short, slug } from "../lib/data.mjs";

const cols = [
  ["Ports", groups.map((g) => [`/ports/#${slug(g.title)}`, g.title])],
  ["Flavors", flavors.map((f) => [`/flavors/${f.id}/`, short(f)])],
  ["Source", [[ORG, "GitHub"], [`${REPO}/blob/main/palette.json`, "palette.json"], [PORT_REQUEST, "Request a port"], [COLOR_FEEDBACK, "Report a color"]]],
] as const;
---

<footer class="shell pb-8 pt-(--section)">
  <Glyphs shape="mark" label="Living Code" class="mx-auto h-[clamp(180px,26vw,360px)] max-w-[960px]" style={`color: ${flavorById.night.colors.teal.hex}`}>
    <Mark class="h-[70%] max-w-[94%]" />
  </Glyphs>

  <div class="mt-[clamp(48px,6vw,88px)] grid grid-cols-2 justify-start gap-10 sm:grid-cols-[repeat(3,max-content)] sm:gap-x-16">
    {cols.map(([title, items]) => (
      <nav class="text-left" aria-label={title}>
        <h2 class="mb-3.5 text-sm font-medium text-muted">{title}</h2>
        <ul class="grid justify-items-start gap-2">
          {items.map(([href, label]) => <li><a class="no-underline transition-colors hover:text-accent" href={href}>{label}</a></li>)}
        </ul>
      </nav>
    ))}
  </div>
  <div class="footer-signoff mt-14 grid grid-cols-[minmax(0,1fr)_auto] items-end gap-x-2 gap-y-3 overflow-x-clip text-sm text-muted max-lg:text-[clamp(0.625rem,2.8vw,0.875rem)] lg:gap-x-8">
    <ChameleonCameo pose="perched" interactive class="col-span-2 w-[clamp(128px,12vw,160px)] max-w-full justify-self-end" />
    <p class="footer-copyright row-start-2 whitespace-nowrap">© 2026 <a href="https://elliotluque.com">Elliot Luque</a></p>
    <p class="footer-command col-start-2 row-start-2 justify-self-end whitespace-nowrap"><code class="text-accent">:colorscheme living-code-<span data-flavor-id>night</span></code></p>
  </div>
</footer>
