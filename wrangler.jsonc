{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "living-code-landing",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-03-06",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
